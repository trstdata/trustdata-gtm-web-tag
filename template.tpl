- name: '[Hashing] Email is trimmed, lowercased and hashed'
  code: |-
    runCode(merge(mockData, { eventName: 'generate_lead', eventParametersObject: { user_data: { email: ' Jane@Example.com ' } } }));

    assertThat(hashed).isEqualTo([EMAIL]);
    assertThat(pushed[1][2].user_data).isEqualTo({ email: 'hash' });
- name: '[Hashing] A value that is already a SHA-256 hash is sent as is'
  code: |-
    runCode(merge(mockData, { eventName: 'generate_lead', eventParametersObject: { user_data: { email: SHA256_HEX, phone: SHA256_HEX } } }));

    assertApi('sha256').wasNotCalled();
    assertThat(pushed[1][2].user_data).isEqualTo({ email: SHA256_HEX, phone: SHA256_HEX });
- name: '[Hashing] An international phone (plus sign) is hashed without a country code'
  code: |-
    runCode(merge(mockData, { eventName: 'generate_lead', eventParametersObject: { user_data: { phone: '+44 20 7946 0958' } } }));

    assertThat(hashed).isEqualTo(['+442079460958']);
    assertThat(pushed[1][2].user_data).isEqualTo({ phone: 'hash' });
- name: '[Hashing] A national phone is hashed in E164 format with the default country code'
  code: |-
    runCode(merge(mockData, {
      eventName: 'generate_lead',
      phoneCountryCode: '+33',
      eventParametersObject: { user_data: { phone: '06 01 02 03 04' } }
    }));

    assertThat(hashed).isEqualTo(['+33601020304']);
    assertThat(pushed[1][2].user_data).isEqualTo({ phone: 'hash' });
- name: '[Hashing] A national phone without a default country code is dropped, the rest is kept'
  code: |-
    runCode(merge(mockData, { eventName: 'generate_lead', eventParametersObject: { user_data: { phone: '06 01 02 03 04', first_name: 'Jane' } } }));

    assertApi('sha256').wasNotCalled();
    assertThat(pushed[1][2].user_data).isEqualTo({ first_name: 'Jane' });
- name: '[Hashing] A failed hash drops the field instead of sending it unhashed'
  code: |-
    mock('sha256', function(input, onSuccess, onFailure) { onFailure(); });

    runCode(merge(mockData, { eventName: 'generate_lead', eventParametersObject: { user_data: { email: EMAIL, first_name: 'Jane' } } }));

    assertThat(pushed[1][2].user_data).isEqualTo({ first_name: 'Jane' });
- name: '[Hashing] The event and the tag wait until both hashes have returned'
  code: |-
    // sha256 answers later in a real browser. Hold each answer and release them
    // one at a time.
    const answers = [];
    mock('sha256', function(input, onSuccess) { answers.push(onSuccess); });

    runCode(merge(mockData, {
      eventName: 'generate_lead',
      phoneCountryCode: '33',
      eventParametersObject: { user_data: { email: EMAIL, phone: '0601020304' } }
    }));
    assertThat(answers.length).isEqualTo(2);

    answers[0]('hash');
    assertThat(pushed.length, 'the event was queued with one field still unhashed').isEqualTo(1);
    assertApi('gtmOnSuccess').wasNotCalled();

    answers[1]('hash');
    assertThat(pushed[1][2].user_data).isEqualTo({ email: 'hash', phone: 'hash' });
    assertApi('gtmOnSuccess').wasCalled();
- name: '[Hashing] Raw email and phone never reach the console'
  code: |-
    runCode(merge(mockData, {
      eventName: 'generate_lead',
      debug: true,
      eventParametersObject: { user_data: { email: ' Jane@Example.com ', phone: '06 01 02 03 04' } }
    }));
    mock('sha256', function(input, onSuccess, onFailure) { onFailure(); });
    runCode(merge(mockData, {
      eventName: 'generate_lead',
      phoneCountryCode: '33',
      eventParametersObject: { user_data: { email: EMAIL, phone: '+33 6 01 02 03 04' } }
    }));

    assertThat(logged.length > 0).isTrue();
    logged.forEach(function(message) {
      const compact = message.toLowerCase().split(' ').join('');
      if (compact.indexOf('jane@example.com') !== -1 || compact.indexOf('601020304') !== -1) {
        fail('Personal data logged: ' + message);
      }
    });
- name: '[Consent] Manual values accept granted, true and 1, anything else is denied, and empty sale of data is allowed'
  code: |-
    const manual = { commandType: 'consent', consentModeChoice: 'manual' };
    runCode(merge(merge(mockData, manual), {
      consentAnalytics: 'true', consentAdvertising: '1', consentPreferences: 'denied', consentSaleOfData: ''
    }));
    runCode(merge(merge(mockData, manual), {
      consentAnalytics: '', consentAdvertising: 'granted', consentPreferences: 'yes', consentSaleOfData: 'false'
    }));

    assertThat(pushed.filter(c => c[0] === 'consent').map(c => c[1])).isEqualTo([
      { analytics: true, advertising: true, preferences: false, sale_of_data: true },
      { analytics: false, advertising: true, preferences: false, sale_of_data: false }
    ]);
- name: '[Consent] Consent Mode replaying the current state on page load records no choice'
  code: |-
    page.granted = false;
    runCode(mockData);

    consentListeners.analytics_storage('analytics_storage', false);
    consentListeners.ad_storage('ad_storage', false);
    consentListeners.functionality_storage('functionality_storage', false);

    assertThat(pushed.length).isEqualTo(2);
- name: '[Consent] Accepting analytics records the full consent state at that moment, then links identity'
  code: |-
    page.granted = false;
    runCode(mockData);

    // "Accept all": every type is granted, but the analytics listener fires first.
    page.granted = true;
    consentListeners.analytics_storage('analytics_storage', true);

    assertThat(pushed.slice(2)).isEqualTo([
      ['consent', ALL_GRANTED, { interaction: true }],
      ['linkIdentity']
    ]);
- name: '[Consent] Revoking analytics records the revocation'
  code: |-
    runCode(mockData);

    consentListeners.analytics_storage('analytics_storage', false);

    assertThat(pushed.slice(2)).isEqualTo([['consent', { analytics: false }, { interaction: true }]]);
- name: '[Consent] Advertising and preferences changes are recorded once per change'
  code: |-
    page.granted = false;
    runCode(mockData);

    consentListeners.ad_storage('ad_storage', true);
    consentListeners.ad_storage('ad_storage', true);
    consentListeners.functionality_storage('functionality_storage', true);

    assertThat(pushed.slice(2)).isEqualTo([
      ['consent', { advertising: true }, { interaction: true }],
      ['consent', { preferences: true }, { interaction: true }]
    ]);
- name: '[TCF] A TCF user action records a consent decision'
  code: |-
    page.tcfPresent = true;
    runCode(mockData);

    page.tcfListener({ eventStatus: 'useractioncomplete' }, true);

    assertThat(pushed.slice(2)).isEqualTo([
      ['consent', ALL_GRANTED, { interaction: true }],
      ['linkIdentity']
    ]);
- name: '[TCF] A TCF load replay or a failed callback records nothing'
  code: |-
    page.tcfPresent = true;
    runCode(mockData);

    page.tcfListener({ eventStatus: 'tcloaded' }, true);
    page.tcfListener({ eventStatus: 'cmpuishown' }, true);
    page.tcfListener({ eventStatus: 'useractioncomplete' }, false);
    page.tcfListener(null, true);

    assertThat(pushed.length).isEqualTo(2);
- name: '[TCF] Manual decision capture never touches __tcfapi'
  code: |-
    page.tcfPresent = true;
    mock('copyFromWindow', function(key) {
      if (key === '__tcfapi') fail('Manual capture read __tcfapi');
      return undefined;
    });
    mock('callInWindow', function(fn) {
      if (fn === '__tcfapi') fail('Manual capture called __tcfapi');
    });

    runCode(merge(mockData, { consentCapture: 'manual' }));

    assertApi('gtmOnSuccess').wasCalled();
- name: '[TCF] A page without __tcfapi skips auto-capture and the tag still succeeds'
  code: |-
    runCode(mockData);

    assertThat(page.tcfListener).isUndefined();
    assertApi('gtmOnSuccess').wasCalled();
setup: |-
  const JSON = require('JSON');

  const ATTRIBUTION_ID = '3f2b8c1e-5a4d-4e7f-9b21-0c6d8e4a7f13';
  const EMAIL = 'jane@example.com';
  const SHA256_HEX = '5e884898da28047151d0e56f8dc6292773603d0d6aabbdd62a11ef721d1542d8';
  const ALL_GRANTED = { analytics: true, advertising: true, preferences: true, sale_of_data: true };

  // A complete Initialize + send event tag. A scenario overrides only what it tests.
  const mockData = {
    attributionIds: ATTRIBUTION_ID,
    commandType: 'both',
    eventName: 'page_view',
    consentCapture: 'tcf',
    consentModeChoice: 'google',
    apiHost: 'https://t.trustdata.tech',
    debug: false
  };

  const merge = function(base, overrides) {
    const result = {};
    for (const key in base) {
      if (base.hasOwnProperty(key)) result[key] = base[key];
    }
    for (const key in overrides) {
      if (overrides.hasOwnProperty(key)) result[key] = overrides[key];
    }
    return result;
  };

  // What the page holds. Scenarios change `page` and read the rest.
  const page = { sdkLoaded: false, tcfPresent: false, granted: true };
  const pushed = [];
  const windowCalls = [];
  const hashed = [];
  const logged = [];
  const consentListeners = {};

  // Values are copied when they leave the sandbox, so record each command as it
  // was at push time. A later edit to the same object must not show up here.
  const snapshot = function(value) { return JSON.parse(JSON.stringify(value)); };

  mock('createQueue', function() {
    return function(command) { pushed.push(snapshot(command)); };
  });
  mock('copyFromWindow', function(key) {
    if (key === 'trustdata._loaded') return page.sdkLoaded;
    if (key === '__tcfapi' && page.tcfPresent) return function() {};
    return undefined;
  });
  mock('callInWindow', function(fn, a, b, c) {
    if (fn === '__tcfapi' && a === 'addEventListener') {
      page.tcfListener = c;
      return;
    }
    windowCalls.push(snapshot([fn, a, b]));
  });
  mock('isConsentGranted', function() { return page.granted; });
  mock('addConsentListener', function(type, callback) { consentListeners[type] = callback; });
  mock('injectScript', function(url, onSuccess) { onSuccess(); });
  mock('sha256', function(input, onSuccess) {
    hashed.push(input);
    onSuccess('hash');
  });
  mock('logToConsole', function(message) { logged.push(message); });


