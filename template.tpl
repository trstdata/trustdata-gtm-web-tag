const log = require('logToConsole');
const makeTableMap = require('makeTableMap');
const copyFromWindow = require('copyFromWindow');
const callInWindow = require('callInWindow');
const createQueue = require('createQueue');
const injectScript = require('injectScript');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const JSON = require('JSON');
const sha256 = require('sha256');
const getType = require('getType');
const makeInteger = require('makeInteger');
const Object = require('Object');

const LOG_PREFIX = 'TRDT - ';
const SCRIPT_URL = 'https://t.trustdata.tech/t.js';
const CACHE_TOKEN = 'trustdata-sdk';
const DEFAULT_API_HOST = 'https://t.trustdata.tech';
const DEFAULT_API_PATH = '/api/events';

let previousAnalyticsConsent = false;
let previousAdConsent = false;
let previousPreferencesConsent = false;
let queuePush = null;

// ============ HELPER FUNCTIONS ============

const isSDKLoaded = function() {
  return copyFromWindow('trustdata._loaded') === true;
};

const initQueue = function() {
  if (isSDKLoaded()) {
    log(LOG_PREFIX + 'SDK already loaded, skipping queue init');
    return null;
  }
  const existingType = getType(copyFromWindow('trustdata'));
  log(LOG_PREFIX + 'Existing trustdata type: ' + existingType);
  if (existingType === 'undefined' || existingType === 'null') {
    queuePush = createQueue('trustdata');
    log(LOG_PREFIX + 'Created new queue');
    return queuePush;
  } else if (existingType === 'array') {
    queuePush = createQueue('trustdata');
    log(LOG_PREFIX + 'Using existing queue');
    return queuePush;
  }
  log(LOG_PREFIX + 'trustdata is ' + existingType + ', not array');
  return null;
};

const execCommand = function(cmd) {
  const method = cmd[0];
  log(LOG_PREFIX + 'execCommand: ' + method);
  if (isSDKLoaded()) {
    log(LOG_PREFIX + 'Calling trustdata.' + method);
    if (method === 'init') {
      callInWindow('trustdata.init', cmd[1], cmd[2]);
    } else if (method === 'event') {
      callInWindow('trustdata.event', cmd[1], cmd[2]);
    } else if (method === 'consent') {
      callInWindow('trustdata.consent', cmd[1], cmd[2]);
    } else if (method === 'setUserId') {
      callInWindow('trustdata.setUserId', cmd[1]);
    } else if (method === 'linkIdentity') {
      callInWindow('trustdata.linkIdentity');
    } else if (method === 'debug') {
      callInWindow('trustdata.debug', cmd[1]);
    }
  } else if (queuePush) {
    queuePush(cmd);
    log(LOG_PREFIX + 'Queued: ' + method);
  } else {
    log(LOG_PREFIX + 'ERROR: Cannot execute ' + method + ' - no queue and SDK not loaded');
  }
};

// Manual consent fields hold a GTM variable that resolves to the CMP's value at
// runtime, so accept the common shapes: GCM strings ('granted'/'denied'), bools,
// and '1'/1. Anything else (incl. empty/undefined) reads as denied — the safe
// default.
const isGrantedValue = function(v) {
  return v === 'granted' || v === 'true' || v === true || v === 1 || v === '1';
};

const getConsentSettings = function() {
  // The Consent group is hidden for "Send event", so the field can arrive unset
  // when that command initializes the SDK. Unset means the field's default.
  const isGCM = (data.consentModeChoice || 'google') === 'google';
  let analytics, advertising, preferences, saleOfData;
  if (isGCM) {
    analytics = isConsentGranted('analytics_storage');
    advertising = isConsentGranted('ad_storage');
    preferences = isConsentGranted('functionality_storage');
    // CCPA "do not sell" maps to GCM v2 ad_user_data — denial triggers
    // Google's Restricted Data Processing, same semantic as sale_of_data:false.
    saleOfData = isConsentGranted('ad_user_data');
    log(LOG_PREFIX + 'GCM consent - analytics: ' + analytics + ', ads: ' + advertising + ', sale_of_data: ' + saleOfData);
  } else {
    analytics = isGrantedValue(data.consentAnalytics);
    advertising = isGrantedValue(data.consentAdvertising);
    preferences = isGrantedValue(data.consentPreferences);
    // CCPA is opt-out: default allowed unless a Do-Not-Sell signal is wired in.
    saleOfData = (data.consentSaleOfData === undefined || data.consentSaleOfData === '')
      ? true
      : isGrantedValue(data.consentSaleOfData);
    log(LOG_PREFIX + 'Manual consent - analytics: ' + analytics + ', ads: ' + advertising + ', sale_of_data: ' + saleOfData);
  }
  return {
    analytics: !!analytics,
    advertising: !!advertising,
    preferences: !!preferences,
    sale_of_data: !!saleOfData
  };
};

const processInit = function(consent) {
  const targetId = data.attributionIds;
  if (!targetId) {
    log(LOG_PREFIX + 'ERROR: No attributionIds');
    return false;
  }
  log(LOG_PREFIX + 'Initializing with targetId: ' + targetId);
  const initOptions = {
    apiHost: data.apiHost || DEFAULT_API_HOST,
    apiPath: DEFAULT_API_PATH,
    consent: consent,
    sendPageView: false
  };
  if (data.ignoreDomains) {
    initOptions.ignoreDomains = data.ignoreDomains;
  }
  log(LOG_PREFIX + 'Init options: ' + JSON.stringify(initOptions));
  execCommand(['init', targetId, initOptions]);
  if (data.debug === true) {
    execCommand(['debug', true]);
  }
  if (data.userId && consent.advertising) {
    execCommand(['setUserId', data.userId]);
  }
  // Seed the previous-state trackers from the load-time consent so the consent
  // listeners only fire trustdata.consent() on a genuine CHANGE, never on the
  // initial state callback GCM emits when each listener is registered.
  previousAnalyticsConsent = consent.analytics;
  previousAdConsent = consent.advertising;
  previousPreferencesConsent = consent.preferences;
  return true;
};

const setupConsentListeners = function() {
  addConsentListener('analytics_storage', function(consentType, granted) {
    log(LOG_PREFIX + 'Consent changed: analytics_storage = ' + granted);
    if (granted && !previousAnalyticsConsent) {
      // Race: on "Accept All", ad_storage / functionality_storage listeners
      // fire AFTER this one, so the SDK's advertising flag is still false when
      // linkIdentity ships. Re-read everything from GCM at this instant so the
      // identity_link payload carries the user's full consent state.
      log(LOG_PREFIX + 'Analytics consent upgraded — re-reading full consent');
      const currentConsent = {
        analytics:    true,
        advertising:  isConsentGranted('ad_storage'),
        preferences:  isConsentGranted('functionality_storage'),
        sale_of_data: isConsentGranted('ad_user_data')
      };
      execCommand(['consent', currentConsent, { interaction: true }]);
      execCommand(['linkIdentity']);
    } else if (!granted && previousAnalyticsConsent) {
      log(LOG_PREFIX + 'Analytics consent revoked');
      execCommand(['consent', { analytics: false }, { interaction: true }]);
    }
    previousAnalyticsConsent = granted;
  });
  addConsentListener('ad_storage', function(consentType, granted) {
    // GCM fires this once on registration with the current state; that initial
    // callback matches the load-time value seeded in processInit and must NOT be
    // treated as a user choice, or consent_set would be stamped on every page.
    if (granted === previousAdConsent) return;
    log(LOG_PREFIX + 'Consent changed: ad_storage = ' + granted);
    previousAdConsent = granted;
    execCommand(['consent', { advertising: granted }, { interaction: true }]);
  });
  addConsentListener('functionality_storage', function(consentType, granted) {
    if (granted === previousPreferencesConsent) return;
    log(LOG_PREFIX + 'Consent changed: functionality_storage = ' + granted);
    previousPreferencesConsent = granted;
    execCommand(['consent', { preferences: granted }, { interaction: true }]);
  });

  // Auto-capture genuine decisions via IAB TCF (default). One standard signal for
  // every TCF CMP — closes the reject-to-default gap with no per-CMP trigger and
  // no load stamping. Manual mode skips this and relies on a Consent Decision tag.
  if ((data.consentCapture || 'tcf') === 'tcf') {
    setupTcfListener();
  }
};

const processConsentDecision = function() {
  // Fired by a Custom Event trigger on the CMP's user-interaction event (accept,
  // reject, or save preferences). Records a GENUINE decision (interaction: true)
  // regardless of whether the consent VALUES changed — so a "reject all" that
  // lands on the same values as the default is still captured. addConsentListener
  // can't do this: it only fires on a value change, so a reject-to-default is
  // invisible to it. This is the Consent Mode v2 recommended pattern (trigger on
  // the CMP's consent dataLayer event), and it makes consent_set reflect real
  // choices, not page loads.
  const consent = getConsentSettings();
  log(LOG_PREFIX + 'Consent decision (interaction): ' + JSON.stringify(consent));
  execCommand(['consent', consent, { interaction: true }]);
  // Stitch the pre-consent fingerprint on a genuine analytics grant. Safe to call
  // even when the listener path already did — linkIdentity is idempotent.
  if (consent.analytics) {
    execCommand(['linkIdentity']);
  }
  previousAnalyticsConsent = consent.analytics;
  previousAdConsent = consent.advertising;
  previousPreferencesConsent = consent.preferences;
};

const setupTcfListener = function() {
  // IAB TCF: the 'useractioncomplete' eventStatus fires only when the visitor
  // actively confirms a choice (accept OR reject) — never on a load replay,
  // which is 'tcloaded'. It is one standard signal across every TCF CMP, so we
  // capture real decisions with no per-CMP wiring and no load stamping. Used
  // purely as the interaction trigger; the values are read from Consent Mode.
  // NOTE: publishing this template requires __tcfapi in the access_globals
  // permission (read + execute).
  if (!copyFromWindow('__tcfapi')) {
    log(LOG_PREFIX + 'No __tcfapi on page; TCF auto-capture inactive. Use a Consent Decision tag for a non-TCF CMP.');
    return;
  }
  callInWindow('__tcfapi', 'addEventListener', 2, function(tcData, success) {
    if (success && tcData && tcData.eventStatus === 'useractioncomplete') {
      log(LOG_PREFIX + 'TCF useractioncomplete: recording consent decision');
      processConsentDecision();
    }
  });
};

const isSHA256Hash = function(str) {
  if (getType(str) !== 'string') return false;
  if (str.length !== 64) return false;
  const validHex = '0123456789abcdefABCDEF';
  for (let i = 0; i < str.length; i++) {
    if (validHex.indexOf(str[i]) === -1) return false;
  }
  return true;
};

/**
 * Normalize email for hashing: lowercase and trim
 */
const normalizeEmail = function(email) {
  if (getType(email) !== 'string') return null;
  return email.toLowerCase().trim();
};

const digitsOnly = function(value) {
  const str = '' + value;
  let digits = '';
  for (let i = 0; i < str.length; i++) {
    const char = str.charAt(i);
    if (char >= '0' && char <= '9') {
      digits = digits + char;
    }
  }
  return digits;
};

/**
 * Normalize phone to E.164 for hashing. A number starting with + or with a
 * country code carries its own country; a national number (leading 0) needs the
 * tag's default country code. Returns null when the country is unknown: a hash
 * of the wrong number matches nobody, so the phone is dropped instead.
 * Examples (code 33): "0601020304" -> "+33601020304", "+33 6 01 02 03 04" -> "+33601020304"
 */
const normalizePhone = function(phone) {
  if (getType(phone) !== 'string') return null;
  const digits = digitsOnly(phone);
  if (!digits) return null;
  if (phone.trim().charAt(0) === '+' || digits.charAt(0) !== '0') {
    return '+' + digits;
  }
  const countryCode = data.phoneCountryCode ? digitsOnly(data.phoneCountryCode) : '';
  if (!countryCode) return null;
  return '+' + countryCode + digits.substring(1);
};

// Event name is a dropdown of standard events; '__custom' reveals a free-text
// field (custom name or a variable).
const resolveEventName = function() {
  return (data.eventName === '__custom' ? data.eventNameCustom : data.eventName) || 'page_view';
};

// A funnel_step without a position or a name cannot be placed in a funnel, so
// the tag refuses to send one rather than record a step no report can use.
const funnelStepError = function() {
  if (resolveEventName() !== 'funnel_step') return null;
  if (!(makeInteger(data.stepIndex) > 0)) return 'funnel_step needs a step index of 1 or more';
  if (!data.stepName) return 'funnel_step needs a step name';
  return null;
};

const buildEventProps = function() {
  const eventProps = {};
  if (getType(data.eventParametersObject) === 'object') {
    Object.keys(data.eventParametersObject).forEach(function(key) {
      eventProps[key] = data.eventParametersObject[key];
    });
  }
  if (data.eventParameters && data.eventParameters.length > 0) {
    const tableProps = makeTableMap(data.eventParameters, 'name', 'value');
    Object.keys(tableProps).forEach(function(key) {
      eventProps[key] = tableProps[key];
    });
  }
  if (resolveEventName() === 'funnel_step') {
    eventProps.step_index = makeInteger(data.stepIndex);
    eventProps.step_name = data.stepName;
  }
  return eventProps;
};

const processEvent = function(callback) {
  const eventName = resolveEventName();
  const eventProps = buildEventProps();
  log(LOG_PREFIX + 'Processing event: ' + eventName);

  const sendEvent = function() {
    execCommand(['event', eventName, eventProps]);
    if (callback) callback();
  };

  // Hash user_data fields. Never log their values: Preview logs are shared in
  // screenshots and support tickets.
  if (eventProps.user_data && getType(eventProps.user_data) === 'object') {
    const userData = eventProps.user_data;
    const rawEmail = userData.email;
    const rawPhone = userData.phone;

    const needsEmailHash = rawEmail && !isSHA256Hash(rawEmail);
    let normalizedPhone = null;
    if (rawPhone && !isSHA256Hash(rawPhone)) {
      normalizedPhone = normalizePhone(rawPhone);
      if (!normalizedPhone) {
        log(LOG_PREFIX + 'Phone dropped: national format and no default country code set');
        Object.delete(userData, 'phone');
      }
    }

    let pendingHashes = 0;
    if (needsEmailHash) pendingHashes++;
    if (normalizedPhone) pendingHashes++;

    if (pendingHashes === 0) {
      sendEvent();
      return;
    }

    const onHashComplete = function() {
      pendingHashes--;
      if (pendingHashes === 0) sendEvent();
    };

    // A failed hash drops the field: an unhashed value must never be sent.
    if (needsEmailHash) {
      sha256(normalizeEmail(rawEmail), function(hash) {
        userData.email = hash;
        onHashComplete();
      }, function() {
        log(LOG_PREFIX + 'Email hash failed, email dropped');
        Object.delete(userData, 'email');
        onHashComplete();
      }, { outputEncoding: 'hex' });
    }

    if (normalizedPhone) {
      sha256(normalizedPhone, function(hash) {
        userData.phone = hash;
        onHashComplete();
      }, function() {
        log(LOG_PREFIX + 'Phone hash failed, phone dropped');
        Object.delete(userData, 'phone');
        onHashComplete();
      }, { outputEncoding: 'hex' });
    }
  } else {
    sendEvent();
  }
};

/**
 * Inject the SDK once per page (cacheToken) and complete the tag on the outcome,
 * so a script blocked by an ad blocker or a CSP shows as Failed in Tag Assistant
 * instead of a tag that succeeded and sent nothing.
 */
const loadSDK = function(onSuccess, onFailure) {
  if (isSDKLoaded()) {
    onSuccess();
    return;
  }

  injectScript(
    SCRIPT_URL,
    function() {
      log(LOG_PREFIX + 'SDK script loaded');
      onSuccess();
    },
    function() {
      log(LOG_PREFIX + 'SDK script failed to load (blocked or unreachable): ' + SCRIPT_URL);
      onFailure();
    },
    CACHE_TOKEN
  );
};

// ============ MAIN EXECUTION ============
const commandType = data.commandType || 'both';
log(LOG_PREFIX + '========== START: ' + commandType + ' ==========');

const sendsEvent = commandType === 'both' || commandType === 'event';

if (!data.attributionIds) {
  log(LOG_PREFIX + 'ERROR: attributionIds is required');
  data.gtmOnFailure();
} else if (sendsEvent && funnelStepError()) {
  log(LOG_PREFIX + 'ERROR: ' + funnelStepError());
  data.gtmOnFailure();
} else {
  initQueue();

  if (commandType === 'init') {
    // Initialize SDK only
    const consent = getConsentSettings();
    if (processInit(consent)) {
      setupConsentListeners();
      loadSDK(data.gtmOnSuccess, data.gtmOnFailure);
    } else {
      data.gtmOnFailure();
    }

  } else if (commandType === 'both') {
    // Initialize + send event
    const consent = getConsentSettings();
    if (processInit(consent)) {
      setupConsentListeners();
      processEvent(function() {
        loadSDK(data.gtmOnSuccess, data.gtmOnFailure);
      });
    } else {
      data.gtmOnFailure();
    }

  } else if (commandType === 'event') {
    // Send event only
    if (isSDKLoaded()) {
      // SDK loaded - send directly and complete
      processEvent(function() {
        data.gtmOnSuccess();
      });
    } else {
      // SDK not loaded - initialize, queue event, load SDK
      const consent = getConsentSettings();
      if (processInit(consent)) {
        setupConsentListeners();
        processEvent(function() {
          loadSDK(data.gtmOnSuccess, data.gtmOnFailure);
        });
      } else {
        data.gtmOnFailure();
      }
    }

  } else if (commandType === 'consent') {
    // Consent decision: fired by a Custom Event trigger on the CMP's user-
    // interaction event. Marks a genuine choice (so a reject that matches the
    // default is captured). Requires an Initialize tag to have run on page load;
    // if the SDK has not loaded yet the command is queued and replays on load.
    processConsentDecision();
    data.gtmOnSuccess();
  }
}


