scenarios:
- name: '[Commands] Initialize and send event queues init then page_view and completes when the SDK loads'
  code: |-
    runCode(mockData);

    assertThat(pushed).isEqualTo([
      ['init', ATTRIBUTION_ID, {
        apiHost: 'https://t.trustdata.tech',
        apiPath: '/api/events',
        consent: ALL_GRANTED,
        sendPageView: false
      }],
      ['event', 'page_view', {}]
    ]);
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Commands] Initialize only queues init, sends no event, and loads the SDK'
  code: |-
    runCode(merge(mockData, { commandType: 'init' }));

    assertThat(pushed.length).isEqualTo(1);
    assertThat(pushed[0][0]).isEqualTo('init');
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: '[Commands] Send event on a loaded SDK calls the SDK event method directly and injects nothing'
  code: |-
    page.sdkLoaded = true;

    runCode(merge(mockData, {
      commandType: 'event',
      eventName: 'purchase',
      eventParameters: [{ name: 'value', value: '99.90' }]
    }));

    assertThat(windowCalls).isEqualTo([['trustdata.event', 'purchase', { value: '99.90' }]]);
    assertThat(pushed).isEqualTo([]);
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: '[Commands] Send event before any TrustData tag initializes first, and an unset consent source reads Consent Mode'
  code: |-
    // The Consent group is hidden for Send event, so the field can arrive unset.
    runCode(merge(mockData, { commandType: 'event', eventName: 'purchase', consentModeChoice: undefined }));

    assertThat(pushed[0][0]).isEqualTo('init');
    assertThat(pushed[0][2].consent).isEqualTo(ALL_GRANTED);
    assertThat(pushed[1]).isEqualTo(['event', 'purchase', {}]);
    assertApi('gtmOnSuccess').wasCalled();
- name: '[Commands] Send consent decision records the choice, links identity, and loads nothing'
  code: |-
    runCode(merge(mockData, {
      commandType: 'consent',
      consentModeChoice: 'manual',
      consentAnalytics: 'granted',
      consentAdvertising: 'denied'
    }));

    assertThat(pushed).isEqualTo([
      ['consent', { analytics: true, advertising: false, preferences: false, sale_of_data: true }, { interaction: true }],
      ['linkIdentity']
    ]);
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: '[Commands] A second TrustData tag on the same page loads the SDK through the same cache token'
  code: |-
    const injected = [];
    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      injected.push([url, cacheToken]);
      onSuccess();
    });

    runCode(mockData);
    runCode(merge(mockData, { commandType: 'event', eventName: 'purchase' }));

    // One cache token means one script element. Both tags queue an init: the SDK
    // keeps the first and ignores the repeat ("Already initialized").
    assertThat(injected).isEqualTo([
      ['https://t.trustdata.tech/t.js', 'trustdata-sdk'],
      ['https://t.trustdata.tech/t.js', 'trustdata-sdk']
    ]);
    assertThat(pushed.filter(c => c[0] === 'event').map(c => c[1])).isEqualTo(['page_view', 'purchase']);
    assertApi('gtmOnFailure').wasNotCalled();
- name: '[Commands] A missing Attribution ID fails the tag without loading the SDK'
  code: |-
    runCode(merge(mockData, { attributionIds: '' }));

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
    assertApi('injectScript').wasNotCalled();
    assertThat(pushed).isEqualTo([]);
- name: '[SDK load] A blocked SDK script fails the tag'
  code: |-
    mock('injectScript', function(url, onSuccess, onFailure) { onFailure(); });

    runCode(mockData);

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: '[SDK load] API host, ignored domains and debug reach the SDK'
  code: |-
    runCode(merge(mockData, {
      apiHost: 'https://t.example.com',
      ignoreDomains: 'staging.example.com,localhost',
      debug: true
    }));

    assertThat(pushed[0][2].apiHost).isEqualTo('https://t.example.com');
    assertThat(pushed[0][2].ignoreDomains).isEqualTo('staging.example.com,localhost');
    assertThat(pushed[1]).isEqualTo(['debug', true]);
    assertThat(pushed[2][0]).isEqualTo('event');
- name: '[Event parameters] Variable and table parameters merge, and the table wins'
